<Page
    x:Class="ZorbaGameUWP.Boxup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ZorbaGameUWP"
    xmlns:selectors="using:ZorbaGameUWP.Selectors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid  Grid.Row="0" Grid.Column="0" Background="White">
            <Viewbox x:Name="Viewbox" Stretch="Uniform">
                <Viewbox.Resources>
                    <ResourceDictionary>
                        <selectors:BoxTemplateSelector x:Key="MyBoxSelector" />
                    </ResourceDictionary>
                </Viewbox.Resources>
                <ItemsControl x:Name="BoxupItemsControl"
                    ItemsSource="{Binding ActiveBoxesCollection}"
                    ItemTemplateSelector="{StaticResource MyBoxSelector}"
                >
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas
                                Width="{Binding DataContext.MapWidth, ElementName=BoxupItemsControl, Mode=OneWay}"
                                Height="{Binding DataContext.MapHeight, ElementName=BoxupItemsControl, Mode=OneWay}"
                             >
                                <Canvas.Resources>
                                    <ResourceDictionary>
                                        <!-- Mover Template -->
                                        <DataTemplate x:Key="Mover">
                                            <Polyline Points="0.375,0.375 0.625,0.375 0.625,0.625 0.375,0.625" Fill="Black"/>
                                        </DataTemplate>

                                        <!-- Block Template -->
                                        <DataTemplate x:Key="Block">
                                            <Polyline Points="0.0,0.0 1.0,0.0 1.0,1.0 0.0,1.0 0.0,0.0" Fill="Black"/>
                                        </DataTemplate>

                                        <!-- SmallBox Template -->
                                        <DataTemplate x:Key="SmallBox">
                                            <Polyline Points="0.225,0.225 0.225,0.8 0.8,0.8 0.8,0.225" 
                                                Stroke="{Binding Stroke}" 
                                                StrokeThickness="0.075"
                                                RenderTransformOrigin="0.5,0.5"
                                            >
                                                <Polyline.RenderTransform>
                                                    <RotateTransform Angle="{Binding BoxRotation}"/>
                                                </Polyline.RenderTransform>
                                            </Polyline>
                                        </DataTemplate>

                                        <!-- BigBox Template -->
                                        <DataTemplate x:Key="BigBox">
                                            <Polyline Points="0.1,0.1 0.1,0.9 0.9,0.9 0.9,0.1" 
                                                Stroke="{Binding Stroke}" 
                                                StrokeThickness="0.075"
                                                RenderTransformOrigin="0.5,0.5"
                                            >
                                                <Polyline.RenderTransform>
                                                    <RotateTransform Angle="{Binding BoxRotation}"/>
                                                </Polyline.RenderTransform>
                                            </Polyline>
                                        </DataTemplate>
                                    </ResourceDictionary>
                                </Canvas.Resources>
                            </Canvas>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Viewbox>
        </Grid>
        <StackPanel x:Name="StatusPanel" Grid.Row="1" Grid.Column="0" Orientation="Vertical">
            <Border x:Name="StatusBorder">
                <!-- Use LiveSetting to enable screen readers to announce the status update. -->
                <TextBlock x:Name="StatusBlock" FontWeight="Bold" AutomationProperties.LiveSetting="Assertive" Foreground="White"/>
            </Border>
        </StackPanel>
    </Grid>
</Page>
