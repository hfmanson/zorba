<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ZorbaGame.Views.BigBoxControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Canvas.Left="{x:Bind ViewModel.Left, Mode=OneWay}"
    Canvas.Top="{x:Bind ViewModel.Top, Mode=OneWay}">
    <Polyline Points="0.1,0.1 0.1,0.9 0.9,0.9 0.9,0.1" 
              Stroke="{x:Bind ViewModel.Stroke, Mode=OneWay}" 
              StrokeThickness="0.075"
              RenderTransformOrigin="0.5,0.5">

        <Polyline.RenderTransform>
            <RotateTransform Angle="{x:Bind ViewModel.BoxRotation, Mode=OneWay}"/>
        </Polyline.RenderTransform>
    </Polyline>
</UserControl>
